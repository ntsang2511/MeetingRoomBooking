meta {
  name: 20 Đăng nhập sai mật khẩu (1/5)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{lockEmail}}",
    "password": "WrongPassword1"
  }
}

script:pre-request {
  if (!bru.getVar("lockEmail")) {
    bru.setVar("lockEmail", `lock-${Date.now()}@example.com`);
  }
}

tests {
  test("401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
