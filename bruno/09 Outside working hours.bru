meta {
  name: 09 Đặt ngoài giờ làm việc (mong đợi 400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/bookings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "roomId": {{roomId}},
    "title": "Họp sớm",
    "attendees": 4,
    "startTime": "{{earlyStart}}",
    "endTime": "{{earlyEnd}}"
  }
}

script:pre-request {
  // Ngày mai theo giờ VN (UTC+7), không dùng Intl vì sandbox mặc định của Bruno không có.
  const day = new Date(Date.now() + 7 * 60 * 60 * 1000 + 24 * 60 * 60 * 1000)
    .toISOString()
    .slice(0, 10);
  bru.setVar("earlyStart", `${day}T07:00:00+07:00`);
  bru.setVar("earlyEnd", `${day}T07:30:00+07:00`);
}

tests {
  test("400 và báo giờ làm việc", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().detail).to.contain("working hours");
  });
}
